# Google Apps Script Backend (Current)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_APPS_SCRIPT_ID/usercache

# Google Sheets Integration (Future - for direct API access)
# Only required if moving from Google Apps Script to direct Sheets API
VITE_GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
VITE_GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Data sync settings
VITE_AUTO_SYNC_INTERVAL=300000
